# Copy to .env.local and fill in. Multiple Cerebras keys = wider parallel window.
CEREBRAS_API_KEYS=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gemma-4-31b
CEREBRAS_MAX_TOKENS=4096
CEREBRAS_REASONING_EFFORT=none

EXA_API_KEY=

# Optional
# Enables the public "Share link" upload path via Vercel Blob.
# Vercel sets this automatically when you attach a Blob store.
# BLOB_READ_WRITE_TOKEN=
# GEMINI_API_KEY=
AUDIT_LOG=0
